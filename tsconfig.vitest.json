{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "types": ["vitest/globals", "vitest", "node", "@testing-library/jest-dom"],
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test/**/*",
    "tests/**/*.bench.ts",
    "vitest.config.ts"
  ]
}
